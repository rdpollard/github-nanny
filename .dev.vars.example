# Copy to .dev.vars for local use. Empty values intentionally disable sign-in.
# Keep actual credentials out of this example and out of version control.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
SESSION_SECRET=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
WEB_PUSH_PRIVATE_KEY=""
PUSH_STORAGE_SECRET=""
# Explicit personal-only local scope; production organizations live in wrangler.jsonc.
GITHUB_ORGANIZATIONS="[]"
