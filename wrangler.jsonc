{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-nanny",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ORIGIN": "https://github-nanny.github-nanny.workers.dev",
    "GITHUB_OWNER_ID": "27035363",
    "GITHUB_CLIENT_ID": "Iv23liTv0KKizj08FARz",
    "GITHUB_APP_SLUG": "gh-nanny",
    "GITHUB_ORGANIZATIONS": "[{\"id\":\"5925283\",\"login\":\"stormbots\",\"repositories\":[\"Tactics-Strategy-Dev-Environments\"]}]"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
